# 5c. Degree distributions (CCDF, log-log)
def ccdf(values):
    v = np.sort(np.asarray(values[values > 0]))
    return v, 1 - np.arange(len(v)) / len(v)


fig, ax = plt.subplots(figsize=(6.5, 5))
for deg, lab in [("in_degree", "In-degree (number of suppliers)"),
                 ("out_degree", "Out-degree (number of customers)")]:
    x, y = ccdf(nodes[deg])
    ax.loglog(x, y, "o", ms=5, alpha=0.7, label=lab)
ax.set(xlabel="Degree k", ylabel="P(K >= k)")
ax.legend()
fig.tight_layout()
fig.savefig(f"{OUT_DIR}/fig_degree_distribution.png")
plt.close(fig)
 
